# Required
GROQ_API_KEY=your_groq_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here

# Optional model overrides (defaults shown)
# TEXT_MODEL=openai/gpt-oss-20b
# VISION_MODEL=qwen/qwen3.8-27b          # Groq "preview" model; swap here if it is retired
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # must stay 384-dim for the existing index

# Optional Pinecone overrides (defaults shown)
# PINECONE_INDEX_NAME=novacore-multimodal-rag
# PINECONE_NAMESPACE=fy2026-demo
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# TOP_K=5

# Optional public-demo limits (defaults shown)
# SESSION_QUESTION_LIMIT=10
# DAILY_QUESTION_LIMIT=200
